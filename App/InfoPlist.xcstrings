    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Calendar permission prompt shown by macOS. States what Plyne reads and that nothing leaves the device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyne reads your calendar events for today so it won't suggest a timer during a meeting. Your calendar data is never sent anywhere and stays on this Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyne читает события календаря за сегодня, чтобы не предлагать таймер во время встречи. Данные календаря никуда не отправляются и остаются на этом Mac."
          }
        }
      }
    },
