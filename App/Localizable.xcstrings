    "calendar.connect.rationale" : {
      "comment" : "One-line factual rationale shown under the Connect button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyne reads only today's events so it won't suggest a timer during a meeting. This stays on your device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyne читает только сегодняшние события, чтобы не предлагать таймер во время встречи. Данные остаются на устройстве."
          }
        }
      }
    },
