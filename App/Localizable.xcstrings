    "onboarding.calendar.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyne can read today's events so it won't suggest a timer during a meeting. Your calendar stays on this Mac — nothing is sent anywhere. You can connect it later from the menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyne может читать сегодняшние события, чтобы не предлагать таймер во время встречи. Календарь остаётся на этом Mac — ничего никуда не отправляется. Подключить можно позже из меню."
          }
        }
      }
    },
